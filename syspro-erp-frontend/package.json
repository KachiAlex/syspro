{
  "name": "syspro-erp-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=4096' TAILWIND_DISABLE_LIGHTNINGCSS=1 next dev",
    "build": "cross-env TAILWIND_DISABLE_LIGHTNINGCSS=1 next build",
    "start": "next start",
    "lint": "eslint -c .eslintrc.cjs",
    "lint:it-support": "eslint src/app/tenant-admin/sections/it-support-workspace.tsx src/app/api/support",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:run": "jest --runInBand",
    "test:it-support": "jest src/__tests__/it-support.test.ts -i",
    "test:invoices": "node ./scripts/test-invoices.js",
    "test:vendors": "node ./scripts/test-vendors.js",
    "test:vendors:ci": "start-server-and-test \"npm run dev\" http://localhost:3000 \"npm run test:vendors\"",    "storybook": "start-storybook -p 6006 -s public",
    "build-storybook": "build-storybook -s public",
    "publish-storybook": "npx chromatic --exit-once-uploaded --project-token $CHROMATIC_PROJECT_TOKEN",
    "migrate": "node ./scripts/run-migrations.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "lightningcss": "^1.27.0",
    "lucide-react": "^0.475.0",
    "next": "13.4.12",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.3",
    "@types/node": "^20",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.45.0",
    "eslint-config-next": "13.4.12",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.0.0",
    "jsdom": "^28.0.0",
    "jest-axe": "^6.1.1",
    "pg": "^8.10.0",
    "start-server-and-test": "^1.14.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.1.0",
    "typescript": "^5"
  }
}
