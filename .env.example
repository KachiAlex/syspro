# Copy to .env and fill in real values. NEVER commit a filled .env.
# docker compose reads this file automatically for variable interpolation.

# ─── Database ───
# Local dev: point at your Postgres (or the SSH tunnel to the VPS container DB)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=disable

# Compose-managed Postgres (production)
POSTGRES_USER=syspro
POSTGRES_PASSWORD=change_me
POSTGRES_DB=syspro_erp

# ─── App ───
NEXT_PUBLIC_APP_URL=https://your-domain.com
SESSION_SECRET=generate-a-long-random-string

# Image tag the app container runs (set by deploys; default 'patched')
APP_IMAGE_TAG=patched

# ─── Cron ───
CRON_SECRET=your_cron_bearer_token

# ─── AI Agent (optional — deterministic fallbacks work without these) ───
GROQ_API_KEY=gsk_your_groq_api_key_here
SYSPRO_AI_API_KEY=your_custom_api_key_for_external_agent_access

# ─── Email (optional) ───
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
