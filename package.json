{
  "name": "syspro-erp-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=8192' TAILWIND_DISABLE_LIGHTNINGCSS=1 next dev",
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=8192' TAILWIND_DISABLE_LIGHTNINGCSS=1 next build",
    "start": "next start",
    "lint": "eslint",
    "lint:it-support": "eslint src/app/tenant-admin/sections/it-support-workspace.tsx src/app/api/support",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:it-support": "vitest run src/__tests__/it-support.test.ts",
    "test:invoices": "node ./scripts/test-invoices.js",
    "test:vendors": "node ./scripts/test-vendors.js",
    "test:vendors:ci": "start-server-and-test \"npm run dev\" http://localhost:3000 \"npm run test:vendors\"",
    "migrate": "node ./scripts/run-migrations.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ioredis": "^5.10.1",
    "lightningcss": "^1.27.0",
    "lucide-react": "^0.475.0",
    "next": "13.4.12",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "syspro-erp-frontend": "file:",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.45.0",
    "eslint-config-next": "13.4.12",
    "jsdom": "^28.0.0",
    "pg": "^8.10.0",
    "postcss": "^8",
    "start-server-and-test": "^1.14.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
